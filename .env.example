# Copie para .env.local e preencha. O .env.local NÃO vai para o Git.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# String de conexão do MongoDB (Atlas: Connect > Drivers)
# Sem ela, o site usa os dados locais de db/seed-data (modo sem banco).
MONGODB_URI=

# Nome do banco (opcional, padrão: portfolio)
MONGODB_DB=portfolio

# --- Login do /admin (GitHub OAuth, via Auth.js) ---
# Crie em https://github.com/settings/developers > New OAuth App:
#   Homepage URL:            https://gabrielbarbosa.vercel.app
#   Authorization callback:  https://gabrielbarbosa.vercel.app/api/auth/callback/github
# Para rodar em localhost, adicione também (o GitHub permite múltiplas callback URLs):
#   http://localhost:1337/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Segredo para assinar a sessão. Gere com: npx auth secret
AUTH_SECRET=

# Seu @usuário do GitHub (só ele consegue entrar no /admin). Vários logins: separe por vírgula.
ADMIN_GITHUB_LOGIN=gabrielbarbosaa

# Necessário em produção quando o host não é 100% previsível (ex.: Vercel preview deployments)
AUTH_TRUST_HOST=true
